+//! Both clocks read the browser's: see `sys::web::now`.
+use crate::sys::web;
+use crate::time::Duration;
+
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug, Hash)]
+pub struct Instant(Duration);
+
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug, Hash)]
+pub struct SystemTime(Duration);
+
+pub const UNIX_EPOCH: SystemTime = SystemTime(Duration::from_secs(0));
+
+impl Instant {
+    pub fn now() -> Instant {
+        Instant(web::now())
+    }
+
+    pub fn checked_sub_instant(&self, other: &Instant) -> Option<Duration> {
+        self.0.checked_sub(other.0)
+    }
+
+    pub fn checked_add_duration(&self, other: &Duration) -> Option<Instant> {
+        Some(Instant(self.0.checked_add(*other)?))
+    }
+
+    pub fn checked_sub_duration(&self, other: &Duration) -> Option<Instant> {
+        Some(Instant(self.0.checked_sub(*other)?))
+    }
+}
+
+impl SystemTime {
+    pub const MAX: SystemTime = SystemTime(Duration::MAX);
+
+    pub const MIN: SystemTime = SystemTime(Duration::ZERO);
+
+    pub fn now() -> SystemTime {
+        SystemTime(web::now())
+    }
+
+    pub fn sub_time(&self, other: &SystemTime) -> Result<Duration, Duration> {
+        self.0.checked_sub(other.0).ok_or_else(|| other.0 - self.0)
+    }
+
+    pub fn checked_add_duration(&self, other: &Duration) -> Option<SystemTime> {
+        Some(SystemTime(self.0.checked_add(*other)?))
+    }
+
+    pub fn checked_sub_duration(&self, other: &Duration) -> Option<SystemTime> {
+        Some(SystemTime(self.0.checked_sub(*other)?))
+    }
+}
diff -ruN library.orig/std/src/sys/web.rs library/std/src/sys/web.rs
--- library.orig/std/src/sys/web.rs	1969-12-31 19:00:00
+++ library/std/src/sys/web.rs	2026-10-27 13:34:56
@@ -0,0 +1,105 @@
+//! Horizon's browser build: wasm32-unknown-unknown with atomics, each thread a Web Worker.
+//!
+//! The program defines the `__horizon_web_*` functions (crate `horizon-web`) and the linker
+//! resolves them; std defines the `__horizon_std_*` ones for the program to call. The browser's
+//! main thread must never block (`memory.atomic.wait32` traps there), so it spins wherever std
+//! would wait.
+
+use crate::cell::Cell;
+use crate::collections::BTreeMap;
+use crate::ffi::OsString;
+use crate::sync::atomic::{Atomic, AtomicU64, Ordering};
+use crate::sync::{Mutex, MutexGuard, PoisonError};
+use crate::time::Duration;
+
+unsafe extern "C" {
+    /// Milliseconds since the Unix epoch (`performance.timeOrigin + performance.now()`).
+    fn __horizon_web_now() -> f64;
+    /// Starts a Web Worker that calls `__horizon_std_thread_main(packet)`. Zero on success.
+    fn __horizon_web_spawn(packet: *mut u8) -> i32;
+    /// `navigator.hardwareConcurrency`.
+    fn __horizon_web_parallelism() -> u32;
+    /// Console output: fd 1 is stdout, 2 is stderr.
+    fn __horizon_web_print(fd: u32, ptr: *const u8, len: usize);
+    /// Reads a lazily registered file's bytes into `out` (a `*mut Vec<u8>`); false on failure.
+    fn __horizon_web_fetch(path: *const u8, len: usize, out: *mut u8) -> bool;
+}
+
+#[thread_local]
+static CAN_BLOCK: Cell<bool> = Cell::new(true);
+
+/// The browser's main thread calls this with `false` before it starts anything else.
+#[unsafe(no_mangle)]
+pub extern "C" fn __horizon_std_set_can_block(can_block: bool) {
+    CAN_BLOCK.set(can_block);
+}
+
+pub fn can_block() -> bool {
+    CAN_BLOCK.get()
+}
+
+static LAST_NANOS: AtomicU64 = AtomicU64::new(0);
+
+/// Time since the Unix epoch. Each worker has its own `performance.timeOrigin`, so this never
+/// returns less than any thread saw before: `Instant` stays monotonic across threads.
+pub fn now() -> Duration {
+    let nanos = (unsafe { __horizon_web_now() } * 1_000_000.0) as u64;
+    let last = LAST_NANOS.fetch_max(nanos, Ordering::Relaxed);
+    Duration::from_nanos(nanos.max(last))
+}
+
+/// `futex_wait` for a thread that may not block: true once the value changed, false on timeout.
+pub fn spin_wait(futex: &Atomic<u32>, expected: u32, timeout: Option<Duration>) -> bool {
+    let deadline = timeout.map(|t| now().saturating_add(t));
+    loop {
+        if futex.load(Ordering::Relaxed) != expected {
+            return true;
+        }
+        if deadline.is_some_and(|d| now() >= d) {
+            return false;
+        }
+        crate::hint::spin_loop();
+    }
+}
+
+pub fn spin_sleep(dur: Duration) {
+    let deadline = now().saturating_add(dur);
+    while now() < deadline {
+        crate::hint::spin_loop();
+    }
+}
+
+pub fn spawn(packet: *mut u8) -> bool {
+    unsafe { __horizon_web_spawn(packet) == 0 }
+}
+
+pub fn parallelism() -> usize {
+    unsafe { __horizon_web_parallelism() as usize }
+}
+
+pub fn print(fd: u32, buf: &[u8]) {
+    unsafe { __horizon_web_print(fd, buf.as_ptr(), buf.len()) }
+}
+
+pub fn fetch(path: &[u8]) -> Option<Vec<u8>> {
+    let mut out = Vec::new();
+    let ok = unsafe { __horizon_web_fetch(path.as_ptr(), path.len(), (&raw mut out).cast()) };
+    ok.then_some(out)
+}
+
+pub fn lock<T>(mutex: &Mutex<T>) -> MutexGuard<'_, T> {
+    mutex.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+/// The environment: empty until the program sets it.
+pub static ENV: Mutex<BTreeMap<OsString, OsString>> = Mutex::new(BTreeMap::new());
+
+/// `std::env::args()`, after the program's name.
+pub static ARGS: Mutex<Vec<OsString>> = Mutex::new(Vec::new());
+
+/// Appends one command line argument (UTF-8).
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __horizon_std_push_arg(ptr: *const u8, len: usize) {
+    let bytes = unsafe { crate::slice::from_raw_parts(ptr, len) };
+    lock(&ARGS).push(OsString::from(crate::string::String::from_utf8_lossy(bytes).into_owned()));
+}

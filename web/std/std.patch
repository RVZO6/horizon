+//! The working directory, home and temp folders of the in-memory file system (`sys::fs::memfs`).
+use crate::io;
+use crate::path::{Path, PathBuf};
+use crate::sync::Mutex;
+use crate::sys::web::lock;
+
+static CWD: Mutex<Option<PathBuf>> = Mutex::new(None);
+
+pub fn getcwd() -> io::Result<PathBuf> {
+    Ok(lock(&CWD).clone().unwrap_or_else(|| PathBuf::from("/home/web")))
+}
+
+pub fn chdir(path: &Path) -> io::Result<()> {
+    let path = crate::sys::fs::canonicalize(path)?;
+    if !crate::sys::fs::metadata(&path)?.file_type().is_dir() {
+        return Err(io::const_error!(io::ErrorKind::NotADirectory, "not a directory"));
+    }
+    *lock(&CWD) = Some(path);
+    Ok(())
+}
+
+/// The program as the page names it: there is no file behind it.
+pub fn current_exe() -> io::Result<PathBuf> {
+    Ok(PathBuf::from("/app/horizon"))
+}
+
+pub fn temp_dir() -> PathBuf {
+    PathBuf::from("/tmp")
+}
+
+pub fn home_dir() -> Option<PathBuf> {
+    Some(
+        crate::sys::env::getenv("HOME".as_ref())
+            .map_or_else(|| PathBuf::from("/home/web"), PathBuf::from),
+    )
+}

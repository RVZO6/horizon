diff -ruN library.orig/std/src/sys/env/web.rs library/std/src/sys/env/web.rs
--- library.orig/std/src/sys/env/web.rs	1969-12-31 19:00:00
+++ library/std/src/sys/env/web.rs	2026-10-27 13:34:56
@@ -0,0 +1,23 @@
+//! An environment kept in memory (`sys::web::ENV`), set by the program.
+pub use super::common::Env;
+use crate::ffi::{OsStr, OsString};
+use crate::io;
+use crate::sys::web::{ENV, lock};
+
+pub fn env() -> Env {
+    Env::new(lock(&ENV).iter().map(|(k, v)| (k.clone(), v.clone())).collect())
+}
+
+pub fn getenv(key: &OsStr) -> Option<OsString> {
+    lock(&ENV).get(key).cloned()
+}
+
+pub unsafe fn setenv(key: &OsStr, value: &OsStr) -> io::Result<()> {
+    lock(&ENV).insert(key.to_owned(), value.to_owned());
+    Ok(())
+}
+
+pub unsafe fn unsetenv(key: &OsStr) -> io::Result<()> {
+    lock(&ENV).remove(key);
+    Ok(())
+}
diff -ruN library.orig/std/src/sys/fs/memfs.rs library/std/src/sys/fs/memfs.rs
--- library.orig/std/src/sys/fs/memfs.rs	1969-12-31 19:00:00
+++ library/std/src/sys/fs/memfs.rs	2026-10-27 13:34:56
@@ -0,0 +1,739 @@
+//! An in-memory file system for the browser build. Paths are made absolute against the working
+//! directory (`sys::paths::getcwd`); a file registered with `__horizon_std_memfs_lazy` is fetched
+//! (`sys::web::fetch`) the first time it is read.
+use crate::collections::BTreeMap;
+use crate::ffi::OsString;
+use crate::fmt;
+use crate::fs::TryLockError;
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, SeekFrom};
+use crate::path::{Component, Path, PathBuf};
+use crate::sync::atomic::{AtomicU64, Ordering};
+use crate::sync::{Arc, Mutex, MutexGuard, RwLock};
+pub use crate::sys::fs::common::{Dir, ExtraHomeDirs, ExtraMediaDirs};
+use crate::sys::time::SystemTime;
+use crate::sys::web;
+
+struct FileNode {
+    /// `None` until a lazy file is fetched.
+    data: RwLock<Option<Vec<u8>>>,
+    /// Where a lazy file is fetched from, and its size before then.
+    lazy: Option<(PathBuf, u64)>,
+    modified: Mutex<SystemTime>,
+}
+
+impl FileNode {
+    fn new(data: Option<Vec<u8>>, lazy: Option<(PathBuf, u64)>) -> Arc<FileNode> {
+        Arc::new(FileNode { data: RwLock::new(data), lazy, modified: Mutex::new(SystemTime::now()) })
+    }
+
+    fn load(&self) -> io::Result<()> {
+        if self.data.read().unwrap_or_else(|e| e.into_inner()).is_some() {
+            return Ok(());
+        }
+        let mut data = self.data.write().unwrap_or_else(|e| e.into_inner());
+        if data.is_none() {
+            let (path, _) = self.lazy.as_ref().ok_or(io::Error::from(io::ErrorKind::NotFound))?;
+            let bytes = web::fetch(path.as_os_str().as_encoded_bytes()).ok_or_else(|| {
+                io::const_error!(io::ErrorKind::NotFound, "the browser could not fetch the file")
+            })?;
+            *data = Some(bytes);
+        }
+        Ok(())
+    }
+
+    fn size(&self) -> u64 {
+        match &*self.data.read().unwrap_or_else(|e| e.into_inner()) {
+            Some(data) => data.len() as u64,
+            None => self.lazy.as_ref().map_or(0, |(_, size)| *size),
+        }
+    }
+
+    fn touch(&self) {
+        *web::lock(&self.modified) = SystemTime::now();
+    }
+}
+
+enum Node {
+    Dir(SystemTime),
+    File(Arc<FileNode>),
+}
+
+impl Node {
+    fn attr(&self) -> FileAttr {
+        match self {
+            Node::Dir(modified) => FileAttr { size: 0, dir: true, modified: *modified },
+            Node::File(file) => {
+                FileAttr { size: file.size(), dir: false, modified: *web::lock(&file.modified) }
+            }
+        }
+    }
+}
+
+static TREE: Mutex<BTreeMap<PathBuf, Node>> = Mutex::new(BTreeMap::new());
+
+fn tree() -> MutexGuard<'static, BTreeMap<PathBuf, Node>> {
+    let mut tree = web::lock(&TREE);
+    if tree.is_empty() {
+        for dir in ["/", "/home", "/home/web", "/tmp"] {
+            tree.insert(PathBuf::from(dir), Node::Dir(SystemTime::now()));
+        }
+    }
+    tree
+}
+
+fn normalize(path: &Path) -> io::Result<PathBuf> {
+    let joined;
+    let path = if path.has_root() {
+        path
+    } else {
+        joined = crate::sys::paths::getcwd()?.join(path);
+        &joined
+    };
+    let mut out = PathBuf::from("/");
+    for component in path.components() {
+        match component {
+            Component::Prefix(_) | Component::RootDir | Component::CurDir => {}
+            Component::ParentDir => {
+                out.pop();
+            }
+            Component::Normal(name) => out.push(name),
+        }
+    }
+    Ok(out)
+}
+
+fn not_found() -> io::Error {
+    io::Error::from(io::ErrorKind::NotFound)
+}
+
+/// Fails unless `path`'s parent is a directory.
+fn check_parent(tree: &BTreeMap<PathBuf, Node>, path: &Path) -> io::Result<()> {
+    match path.parent().map(|parent| tree.get(parent)) {
+        Some(Some(Node::Dir(_))) | None => Ok(()),
+        Some(Some(Node::File(_))) => {
+            Err(io::const_error!(io::ErrorKind::NotADirectory, "a parent is a file"))
+        }
+        Some(None) => Err(not_found()),
+    }
+}
+
+/// `path` and everything under it.
+fn subtree(tree: &BTreeMap<PathBuf, Node>, path: &Path) -> Vec<PathBuf> {
+    tree.range(path.to_path_buf()..).map(|(k, _)| k).take_while(|k| k.starts_with(path)).cloned().collect()
+}
+
+/// Registers a file the browser fetches when it is first read; missing parents are created.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __horizon_std_memfs_lazy(ptr: *const u8, len: usize, size: u64) {
+    let bytes = unsafe { crate::slice::from_raw_parts(ptr, len) };
+    let path = PathBuf::from(crate::string::String::from_utf8_lossy(bytes).into_owned());
+    let Ok(path) = normalize(&path) else { return };
+    let mut tree = tree();
+    let mut parent = path.parent();
+    while let Some(dir) = parent {
+        tree.entry(dir.to_path_buf()).or_insert_with(|| Node::Dir(SystemTime::now()));
+        parent = dir.parent();
+    }
+    tree.insert(path.clone(), Node::File(FileNode::new(None, Some((path, size)))));
+}
+
+pub struct File {
+    /// `None` for a directory opened to read its metadata or sync it.
+    node: Option<Arc<FileNode>>,
+    pos: AtomicU64,
+    read: bool,
+    write: bool,
+    append: bool,
+}
+
+#[derive(Clone)]
+pub struct FileAttr {
+    size: u64,
+    dir: bool,
+    modified: SystemTime,
+}
+
+pub struct ReadDir {
+    root: PathBuf,
+    entries: crate::vec::IntoIter<DirEntry>,
+}
+
+pub struct DirEntry {
+    path: PathBuf,
+    attr: FileAttr,
+}
+
+#[derive(Clone, Debug)]
+pub struct OpenOptions {
+    read: bool,
+    write: bool,
+    append: bool,
+    truncate: bool,
+    create: bool,
+    create_new: bool,
+}
+
+#[derive(Copy, Clone, Debug, Default)]
+pub struct FileTimes {
+    modified: Option<SystemTime>,
+}
+
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct FilePermissions {
+    readonly: bool,
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Hash, Debug)]
+pub struct FileType {
+    dir: bool,
+}
+
+#[derive(Debug)]
+pub struct DirBuilder {}
+
+impl FileAttr {
+    pub fn size(&self) -> u64 {
+        self.size
+    }
+
+    pub fn perm(&self) -> FilePermissions {
+        FilePermissions { readonly: false }
+    }
+
+    pub fn file_type(&self) -> FileType {
+        FileType { dir: self.dir }
+    }
+
+    pub fn modified(&self) -> io::Result<SystemTime> {
+        Ok(self.modified)
+    }
+
+    pub fn accessed(&self) -> io::Result<SystemTime> {
+        Ok(self.modified)
+    }
+
+    pub fn created(&self) -> io::Result<SystemTime> {
+        Ok(self.modified)
+    }
+}
+
+impl FilePermissions {
+    pub fn readonly(&self) -> bool {
+        self.readonly
+    }
+
+    pub fn set_readonly(&mut self, readonly: bool) {
+        self.readonly = readonly
+    }
+}
+
+impl FileTimes {
+    pub fn set_accessed(&mut self, _t: SystemTime) {}
+    pub fn set_modified(&mut self, t: SystemTime) {
+        self.modified = Some(t);
+    }
+}
+
+impl FileType {
+    pub fn is_dir(&self) -> bool {
+        self.dir
+    }
+
+    pub fn is_file(&self) -> bool {
+        !self.dir
+    }
+
+    pub fn is_symlink(&self) -> bool {
+        false
+    }
+}
+
+impl ReadDir {
+    pub fn dir(&self) -> io::Result<Dir> {
+        Dir::open_for_traversal(&self.root)
+    }
+}
+
+impl fmt::Debug for ReadDir {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ReadDir").field("root", &self.root).finish()
+    }
+}
+
+impl Iterator for ReadDir {
+    type Item = io::Result<DirEntry>;
+
+    fn next(&mut self) -> Option<io::Result<DirEntry>> {
+        self.entries.next().map(Ok)
+    }
+}
+
+impl DirEntry {
+    pub fn path(&self) -> PathBuf {
+        self.path.clone()
+    }
+
+    pub fn file_name(&self) -> OsString {
+        self.path.file_name().map(|n| n.to_owned()).unwrap_or_default()
+    }
+
+    pub fn metadata(&self) -> io::Result<FileAttr> {
+        Ok(self.attr.clone())
+    }
+
+    pub fn file_type(&self) -> io::Result<FileType> {
+        Ok(self.attr.file_type())
+    }
+}
+
+impl OpenOptions {
+    pub fn new() -> OpenOptions {
+        OpenOptions {
+            read: false,
+            write: false,
+            append: false,
+            truncate: false,
+            create: false,
+            create_new: false,
+        }
+    }
+
+    pub fn read(&mut self, read: bool) {
+        self.read = read;
+    }
+    pub fn write(&mut self, write: bool) {
+        self.write = write;
+    }
+    pub fn append(&mut self, append: bool) {
+        self.append = append;
+    }
+    pub fn truncate(&mut self, truncate: bool) {
+        self.truncate = truncate;
+    }
+    pub fn create(&mut self, create: bool) {
+        self.create = create;
+    }
+    pub fn create_new(&mut self, create_new: bool) {
+        self.create_new = create_new;
+    }
+}
+
+impl File {
+    pub fn open(path: &Path, opts: &OpenOptions) -> io::Result<File> {
+        let path = normalize(path)?;
+        let writes = opts.write || opts.append;
+        let node = {
+            let mut tree = tree();
+            match tree.get(&path) {
+                Some(_) if opts.create_new => {
+                    return Err(io::Error::from(io::ErrorKind::AlreadyExists));
+                }
+                Some(Node::Dir(_)) if writes => {
+                    return Err(io::Error::from(io::ErrorKind::IsADirectory));
+                }
+                Some(Node::Dir(_)) => None,
+                Some(Node::File(file)) => Some(file.clone()),
+                None if opts.create || opts.create_new => {
+                    check_parent(&tree, &path)?;
+                    let file = FileNode::new(Some(Vec::new()), None);
+                    tree.insert(path, Node::File(file.clone()));
+                    Some(file)
+                }
+                None => return Err(not_found()),
+            }
+        };
+        if let Some(file) = &node {
+            if opts.truncate && writes {
+                *file.data.write().unwrap_or_else(|e| e.into_inner()) = Some(Vec::new());
+                file.touch();
+            }
+        }
+        Ok(File {
+            node,
+            pos: AtomicU64::new(0),
+            read: opts.read || !writes,
+            write: writes,
+            append: opts.append,
+        })
+    }
+
+    fn file(&self) -> io::Result<&Arc<FileNode>> {
+        self.node.as_ref().ok_or(io::Error::from(io::ErrorKind::IsADirectory))
+    }
+
+    pub fn file_attr(&self) -> io::Result<FileAttr> {
+        Ok(match &self.node {
+            Some(file) => Node::File(file.clone()).attr(),
+            None => FileAttr { size: 0, dir: true, modified: SystemTime::now() },
+        })
+    }
+
+    pub fn fsync(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn datasync(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn lock(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn lock_shared(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn try_lock(&self) -> Result<(), TryLockError> {
+        Ok(())
+    }
+
+    pub fn try_lock_shared(&self) -> Result<(), TryLockError> {
+        Ok(())
+    }
+
+    pub fn unlock(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn truncate(&self, size: u64) -> io::Result<()> {
+        let file = self.file()?;
+        file.load()?;
+        let mut data = file.data.write().unwrap_or_else(|e| e.into_inner());
+        data.get_or_insert_default().resize(size as usize, 0);
+        drop(data);
+        file.touch();
+        Ok(())
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        if !self.read {
+            return Err(io::const_error!(io::ErrorKind::PermissionDenied, "not open for reading"));
+        }
+        let file = self.file()?;
+        file.load()?;
+        let data = file.data.read().unwrap_or_else(|e| e.into_inner());
+        let data = data.as_deref().unwrap_or_default();
+        let pos = (self.pos.load(Ordering::Relaxed) as usize).min(data.len());
+        let n = buf.len().min(data.len() - pos);
+        buf[..n].copy_from_slice(&data[pos..pos + n]);
+        self.pos.store((pos + n) as u64, Ordering::Relaxed);
+        Ok(n)
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        let mut total = 0;
+        for buf in bufs {
+            let n = self.read(buf)?;
+            total += n;
+            if n < buf.len() {
+                break;
+            }
+        }
+        Ok(total)
+    }
+
+    pub fn is_read_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn read_buf(&self, mut cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        let n = self.read(cursor.ensure_init())?;
+        cursor.advance_checked(n);
+        Ok(())
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        if !self.write {
+            return Err(io::const_error!(io::ErrorKind::PermissionDenied, "not open for writing"));
+        }
+        let file = self.file()?;
+        file.load()?;
+        let mut data = file.data.write().unwrap_or_else(|e| e.into_inner());
+        let data = data.get_or_insert_default();
+        let pos = if self.append { data.len() } else { self.pos.load(Ordering::Relaxed) as usize };
+        if data.len() < pos + buf.len() {
+            data.resize(pos + buf.len(), 0);
+        }
+        data[pos..pos + buf.len()].copy_from_slice(buf);
+        self.pos.store((pos + buf.len()) as u64, Ordering::Relaxed);
+        file.touch();
+        Ok(buf.len())
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        let mut total = 0;
+        for buf in bufs {
+            total += self.write(buf)?;
+        }
+        Ok(total)
+    }
+
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn seek(&self, pos: SeekFrom) -> io::Result<u64> {
+        let (base, offset) = match pos {
+            SeekFrom::Start(n) => {
+                self.pos.store(n, Ordering::Relaxed);
+                return Ok(n);
+            }
+            SeekFrom::End(offset) => (self.file()?.size(), offset),
+            SeekFrom::Current(offset) => (self.pos.load(Ordering::Relaxed), offset),
+        };
+        let new = base.checked_add_signed(offset).ok_or(io::const_error!(
+            io::ErrorKind::InvalidInput,
+            "invalid seek to a negative or overflowing position"
+        ))?;
+        self.pos.store(new, Ordering::Relaxed);
+        Ok(new)
+    }
+
+    pub fn size(&self) -> Option<io::Result<u64>> {
+        Some(self.file().map(|f| f.size()))
+    }
+
+    pub fn tell(&self) -> io::Result<u64> {
+        Ok(self.pos.load(Ordering::Relaxed))
+    }
+
+    pub fn duplicate(&self) -> io::Result<File> {
+        Ok(File {
+            node: self.node.clone(),
+            pos: AtomicU64::new(self.pos.load(Ordering::Relaxed)),
+            read: self.read,
+            write: self.write,
+            append: self.append,
+        })
+    }
+
+    pub fn set_permissions(&self, _perm: FilePermissions) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn set_times(&self, times: FileTimes) -> io::Result<()> {
+        if let (Some(file), Some(t)) = (&self.node, times.modified) {
+            *web::lock(&file.modified) = t;
+        }
+        Ok(())
+    }
+}
+
+impl DirBuilder {
+    pub fn new() -> DirBuilder {
+        DirBuilder {}
+    }
+
+    pub fn mkdir(&self, p: &Path) -> io::Result<()> {
+        let path = normalize(p)?;
+        let mut tree = tree();
+        if tree.contains_key(&path) {
+            return Err(io::Error::from(io::ErrorKind::AlreadyExists));
+        }
+        check_parent(&tree, &path)?;
+        tree.insert(path, Node::Dir(SystemTime::now()));
+        Ok(())
+    }
+}
+
+impl fmt::Debug for File {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("File").field("pos", &self.pos).finish()
+    }
+}
+
+pub fn readdir(p: &Path) -> io::Result<ReadDir> {
+    let root = normalize(p)?;
+    let tree = tree();
+    match tree.get(&root) {
+        Some(Node::Dir(_)) => {}
+        Some(Node::File(_)) => {
+            return Err(io::const_error!(io::ErrorKind::NotADirectory, "not a directory"));
+        }
+        None => return Err(not_found()),
+    }
+    let entries: Vec<DirEntry> = tree
+        .range(root.clone()..)
+        .take_while(|(k, _)| k.starts_with(&root))
+        .filter(|(k, _)| k.parent() == Some(&root))
+        .map(|(k, node)| DirEntry { path: p.join(k.file_name().unwrap_or_default()), attr: node.attr() })
+        .collect();
+    Ok(ReadDir { root, entries: entries.into_iter() })
+}
+
+pub fn unlink(p: &Path) -> io::Result<()> {
+    let path = normalize(p)?;
+    let mut tree = tree();
+    match tree.get(&path) {
+        Some(Node::File(_)) => {
+            tree.remove(&path);
+            Ok(())
+        }
+        Some(Node::Dir(_)) => Err(io::Error::from(io::ErrorKind::IsADirectory)),
+        None => Err(not_found()),
+    }
+}
+
+fn rename_in(tree: &mut BTreeMap<PathBuf, Node>, old: &Path, new: &Path) -> io::Result<()> {
+    let old_dir = match tree.get(old) {
+        Some(Node::Dir(_)) => true,
+        Some(Node::File(_)) => false,
+        None => return Err(not_found()),
+    };
+    if old == new {
+        return Ok(());
+    }
+    if new.starts_with(old) {
+        return Err(io::const_error!(io::ErrorKind::InvalidInput, "cannot move into itself"));
+    }
+    check_parent(tree, new)?;
+    match tree.get(new) {
+        Some(Node::Dir(_)) if !old_dir => {
+            return Err(io::Error::from(io::ErrorKind::IsADirectory));
+        }
+        Some(Node::File(_)) if old_dir => {
+            return Err(io::Error::from(io::ErrorKind::NotADirectory));
+        }
+        Some(Node::Dir(_)) if subtree(tree, new).len() > 1 => {
+            return Err(io::Error::from(io::ErrorKind::DirectoryNotEmpty));
+        }
+        _ => {}
+    }
+    tree.remove(new);
+    for key in subtree(tree, old) {
+        let node = tree.remove(&key).unwrap();
+        let moved = if key == old { new.to_path_buf() } else { new.join(key.strip_prefix(old).unwrap()) };
+        tree.insert(moved, node);
+    }
+    Ok(())
+}
+
+pub fn rename(old: &Path, new: &Path) -> io::Result<()> {
+    let (old, new) = (normalize(old)?, normalize(new)?);
+    rename_in(&mut tree(), &old, &new)
+}
+
+pub fn rename_noreplace(old: &Path, new: &Path) -> io::Result<()> {
+    let (old, new) = (normalize(old)?, normalize(new)?);
+    let mut tree = tree();
+    if tree.contains_key(&new) {
+        return Err(io::Error::from(io::ErrorKind::AlreadyExists));
+    }
+    rename_in(&mut tree, &old, &new)
+}
+
+pub fn set_perm(p: &Path, _perm: FilePermissions) -> io::Result<()> {
+    stat(p).map(drop)
+}
+
+pub fn set_perm_nofollow(p: &Path, perm: FilePermissions) -> io::Result<()> {
+    set_perm(p, perm)
+}
+
+pub fn set_times(p: &Path, times: FileTimes) -> io::Result<()> {
+    let path = normalize(p)?;
+    match tree().get(&path) {
+        Some(Node::File(file)) => {
+            if let Some(t) = times.modified {
+                *web::lock(&file.modified) = t;
+            }
+            Ok(())
+        }
+        Some(Node::Dir(_)) => Ok(()),
+        None => Err(not_found()),
+    }
+}
+
+pub fn set_times_nofollow(p: &Path, times: FileTimes) -> io::Result<()> {
+    set_times(p, times)
+}
+
+pub fn rmdir(p: &Path) -> io::Result<()> {
+    let path = normalize(p)?;
+    let mut tree = tree();
+    match tree.get(&path) {
+        Some(Node::Dir(_)) if subtree(&tree, &path).len() > 1 => {
+            Err(io::Error::from(io::ErrorKind::DirectoryNotEmpty))
+        }
+        Some(Node::Dir(_)) => {
+            tree.remove(&path);
+            Ok(())
+        }
+        Some(Node::File(_)) => {
+            Err(io::const_error!(io::ErrorKind::NotADirectory, "not a directory"))
+        }
+        None => Err(not_found()),
+    }
+}
+
+pub fn remove_dir_all(path: &Path) -> io::Result<()> {
+    let path = normalize(path)?;
+    let mut tree = tree();
+    match tree.get(&path) {
+        Some(Node::Dir(_)) => {
+            for key in subtree(&tree, &path) {
+                tree.remove(&key);
+            }
+            Ok(())
+        }
+        Some(Node::File(_)) => {
+            Err(io::const_error!(io::ErrorKind::NotADirectory, "not a directory"))
+        }
+        None => Err(not_found()),
+    }
+}
+
+pub fn exists(path: &Path) -> io::Result<bool> {
+    let path = normalize(path)?;
+    Ok(tree().contains_key(&path))
+}
+
+pub fn readlink(_p: &Path) -> io::Result<PathBuf> {
+    Err(io::const_error!(io::ErrorKind::InvalidInput, "not a symbolic link"))
+}
+
+pub fn symlink(_original: &Path, _link: &Path) -> io::Result<()> {
+    crate::sys::unsupported()
+}
+
+pub fn link(_src: &Path, _dst: &Path) -> io::Result<()> {
+    crate::sys::unsupported()
+}
+
+pub fn stat(p: &Path) -> io::Result<FileAttr> {
+    let path = normalize(p)?;
+    tree().get(&path).map(Node::attr).ok_or_else(not_found)
+}
+
+pub fn lstat(p: &Path) -> io::Result<FileAttr> {
+    stat(p)
+}
+
+pub fn canonicalize(p: &Path) -> io::Result<PathBuf> {
+    let path = normalize(p)?;
+    if tree().contains_key(&path) { Ok(path) } else { Err(not_found()) }
+}
+
+pub fn copy(from: &Path, to: &Path) -> io::Result<u64> {
+    let source = {
+        let path = normalize(from)?;
+        match tree().get(&path) {
+            Some(Node::File(file)) => file.clone(),
+            Some(Node::Dir(_)) => return Err(io::Error::from(io::ErrorKind::IsADirectory)),
+            None => return Err(not_found()),
+        }
+    };
+    source.load()?;
+    let bytes = source.data.read().unwrap_or_else(|e| e.into_inner()).clone().unwrap_or_default();
+    let mut opts = OpenOptions::new();
+    opts.write(true);
+    opts.create(true);
+    opts.truncate(true);
+    File::open(to, &opts)?.write(&bytes)?;
+    Ok(bytes.len() as u64)
+}

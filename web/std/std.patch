@@ -0,0 +1,83 @@
+//! Threads on Web Workers: the program's `__horizon_web_spawn` starts a worker on the shared
+//! memory, and the worker calls `__horizon_std_thread_main` with the packet.
+use crate::ffi::CStr;
+use crate::io;
+use crate::num::NonZero;
+use crate::sync::Arc;
+use crate::sync::atomic::{Atomic, AtomicU32, Ordering};
+use crate::sys::web;
+use crate::thread::ThreadInit;
+use crate::time::Duration;
+
+pub struct Thread {
+    done: Arc<Atomic<u32>>,
+}
+
+/// wasm-bindgen gives every worker the same stack size when it starts.
+pub const DEFAULT_MIN_STACK_SIZE: usize = 1024 * 1024;
+
+struct Packet {
+    init: Box<ThreadInit>,
+    done: Arc<Atomic<u32>>,
+}
+
+impl Thread {
+    // unsafe: see thread::Builder::spawn_unchecked for safety requirements
+    pub unsafe fn new(_stack: usize, init: Box<ThreadInit>) -> io::Result<Thread> {
+        let done = Arc::new(AtomicU32::new(0));
+        let packet = Box::into_raw(Box::new(Packet { init, done: done.clone() }));
+        if web::spawn(packet.cast()) {
+            Ok(Thread { done })
+        } else {
+            drop(unsafe { Box::from_raw(packet) });
+            Err(io::const_error!(io::ErrorKind::Other, "could not start a Web Worker"))
+        }
+    }
+
+    pub fn join(self) {
+        while self.done.load(Ordering::Acquire) == 0 {
+            if web::can_block() {
+                let futex = self.done.as_ptr().cast::<i32>();
+                unsafe { core::arch::wasm32::memory_atomic_wait32(futex, 0, -1) };
+            } else {
+                web::spin_wait(&self.done, 0, None);
+            }
+        }
+    }
+}
+
+/// A new worker's entry point.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __horizon_std_thread_main(packet: *mut u8) {
+    let packet = unsafe { Box::from_raw(packet.cast::<Packet>()) };
+    let Packet { init, done } = *packet;
+    let start = init.init();
+    start();
+    done.store(1, Ordering::Release);
+    unsafe { core::arch::wasm32::memory_atomic_notify(done.as_ptr().cast(), u32::MAX) };
+}
+
+pub fn available_parallelism() -> io::Result<NonZero<usize>> {
+    NonZero::new(web::parallelism()).ok_or(io::Error::UNKNOWN_THREAD_COUNT)
+}
+
+pub fn current_os_id() -> Option<u64> {
+    None
+}
+
+pub fn yield_now() {}
+
+pub fn set_name(_name: &CStr) {}
+
+pub fn sleep(dur: Duration) {
+    if !web::can_block() {
+        return web::spin_sleep(dur);
+    }
+    let mut nanos = dur.as_nanos();
+    while nanos > 0 {
+        let amt = crate::cmp::min(i64::MAX as u128, nanos);
+        let mut x = 0;
+        unsafe { core::arch::wasm32::memory_atomic_wait32(&mut x, 0, amt as i64) };
+        nanos -= amt;
+    }
+}
